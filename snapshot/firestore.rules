rules_version = '2';
// ============================================================================
// REGRAS DO FIRESTORE — Chernobyl-PT-IA7
// ----------------------------------------------------------------------------
// Este arquivo é a fonte da verdade do repositório para as regras do
// Firestore. O deploy é feito MANUALMENTE (copiar/colar no console do
// Firebase → Firestore Database → Regras); mantenha este arquivo sincronizado
// a cada alteração.
//
// Alterações de Cloud Functions NÃO passam por aqui: o Admin SDK ignora as
// regras. Estas controlam apenas o acesso direto do CLIENTE (web/Electron).
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isBoss() {
      return isAuth() && userRole() == 'Boss';
    }
    function isVIP() {
      return isAuth() && (
        userRole() == 'Boss'
        || (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vipExpiresAt != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vipExpiresAt > request.time
        )
      );
    }
    function isNormal() {
      return isAuth() && !isBoss() && !(
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vipExpiresAt != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vipExpiresAt > request.time
      );
    }
    function isOwner(field) {
      return isAuth() && request.auth.uid == resource.data[field];
    }
    function isCreatingAsOwner(field) {
      return isAuth() && request.resource.data[field] == request.auth.uid;
    }
    function isApproved() {
      return isAuth()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'aprovado';
    }
    function isApprovedUser() {
      return isApproved();
    }
    match /settings/{doc} {
      allow read, write: if isAuth();
    }
    match /appSettings/{doc} {
      allow read: if isAuth() && isApproved();
      allow create, update, delete: if isBoss();
    }
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if request.resource.data.keys().hasOnly([
          'createdAt',
          'email',
          'mainCharacterName',
          'nome',
          'role',
          'status',
          'uid',
          'whatsappCountry',
          'whatsappNumber',
          'whatsappRegion'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.createdAt is number
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 120
        && request.resource.data.mainCharacterName is string
        && request.resource.data.mainCharacterName.size() > 0
        && request.resource.data.mainCharacterName.size() <= 50
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 80
        && request.resource.data.role == 'Normal'
        && request.resource.data.status == 'pendente'
        && request.resource.data.whatsappCountry is string
        && request.resource.data.whatsappCountry.size() > 0
        && request.resource.data.whatsappCountry.size() <= 5
        && request.resource.data.whatsappNumber is string
        && request.resource.data.whatsappNumber.size() > 0
        && request.resource.data.whatsappNumber.size() <= 20
        && request.resource.data.whatsappRegion is string
        && request.resource.data.whatsappRegion.size() > 0
        && request.resource.data.whatsappRegion.size() <= 5;
      allow update: if (
          request.auth.uid == userId
          && isApproved()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role',
            'status'
          ])
        )
        || isBoss();
      allow delete: if isBoss();
      // Histórico privado criado por Cloud Functions. O cliente só lê o seu.
      match /partyHistory/{partyId} {
        allow read: if isAuth() && isApproved() && (request.auth.uid == userId || isBoss());
        allow write: if false;
      }
      // Correções LOCAIS do usuário (Drop/Lucro dos SEUS personagens) sobre a
      // projeção do histórico privado. Documento de exibição particular: o
      // backend nunca lê/escreve aqui e ele NUNCA altera a projeção oficial,
      // a PT ou o que outros usuários veem — por isso os valores dos mapas
      // não são validados item a item (regras não iteram maps); o formato e o
      // dono do documento são o que importa. Gravação inteira do próprio doc
      // (sem merge), só pelo dono da conta aprovado.
      match /partyHistoryOverrides/{partyId} {
        allow read: if isAuth() && isApproved() && (request.auth.uid == userId || isBoss());
        allow create, update: if isAuth() && isApproved()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['partyId', 'drops', 'profits', 'updatedAt'])
          && request.resource.data.partyId == partyId
          && request.resource.data.partyId is string
          && request.resource.data.drops is map
          && request.resource.data.drops.size() >= 0
          && request.resource.data.drops.size() <= 60
          && request.resource.data.profits is map
          && request.resource.data.profits.size() >= 0
          && request.resource.data.profits.size() <= 60
          && request.resource.data.updatedAt is number
          && request.resource.data.updatedAt >= 0;
        allow delete: if isAuth() && isApproved() && request.auth.uid == userId;
      }
      match /friends/{friendUid} {
        allow read: if isAuth() && isApproved() && (
          request.auth.uid == userId || request.auth.uid == friendUid || isBoss()
        );
        allow create: if isAuth() && isApproved()
          && userId != friendUid
          && request.resource.data.keys().hasOnly(['status', 'createdAt'])
          && request.resource.data.createdAt is number
          && (
            (request.auth.uid == userId && request.resource.data.status == 'enviada')
            ||
            (request.auth.uid == friendUid && request.resource.data.status == 'pendente')
          );
        allow update: if isAuth() && isApproved()
          && userId != friendUid
          && (
            (
              request.resource.data.status == 'aceita'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
              && request.resource.data.acceptedAt is number
              && (
                (resource.data.status == 'pendente' && request.auth.uid == userId)
                ||
                (resource.data.status == 'enviada' && request.auth.uid == friendUid)
              )
            )
            ||
            (
              request.resource.data.keys().hasOnly(['status', 'createdAt'])
              && request.resource.data.createdAt is number
              && (
                (request.auth.uid == userId && request.resource.data.status == 'enviada')
                ||
                (request.auth.uid == friendUid && request.resource.data.status == 'pendente')
              )
            )
          );
        allow delete: if isAuth() && isApproved() && (
          request.auth.uid == userId || request.auth.uid == friendUid || isBoss()
        );
      }
    }
    match /characters/{charId} {
      allow read: if isAuth() && isApproved();
      allow create: if isAuth() && isApproved() && isCreatingAsOwner('createdBy');
      allow update: if (isOwner('createdBy') || isVIP()) && isApproved();
      allow delete: if (isOwner('createdBy') || isVIP()) && isApproved();
    }
    match /sharedCharacters/{charId} {
      allow read: if isAuth() && isApproved();
      allow create, update, delete: if isAuth()
        && isApproved()
        && request.auth.uid == charId;
      allow update: if isAuth()
        && isApproved()
        && request.auth.uid != charId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['probableMarkers', 'partyProfit']);
      allow create: if isAuth()
        && isApproved()
        && request.auth.uid != charId
        && request.resource.data.keys().hasOnly(['probableMarkers', 'partyProfit']);
    }
    match /parties/{partyId} {
      function isPartyLeader(data) {
        return request.auth.uid == data.leaderUid;
      }
      function isPartyParticipant(data) {
        return isPartyLeader(data)
          || (data.members != null && request.auth.uid in data.members)
          || (data.invitedUsers != null && request.auth.uid in data.invitedUsers);
      }
      // PT pública visível a quem tem acesso: SOMENTE antes do início da
      // Quest. Após `ptStartedAt`, externos perdem a leitura — a PT passa a
      // ser privada aos participantes (líder/`members`/convidados).
      //
      // CAMPOS AUSENTES: acessar `data.campo` inexistente ERRA a expressão e
      // a regra NEGA por falha (fail-closed). PTs recém-criadas não têm
      // `questConcluida`/`questFalha`/`pagamentoFeito`/`ptStartedAt` — por
      // isso TODO campo opcional usa `.get(campo, default)`. Este era o bug
      // que travava participantes de editar PTs pré-Quest (e sumia com as PTs
      // públicas da busca dos VIPs).
      function isPublicActiveParty(data) {
        return data.visibility == 'public'
          && data.get('questConcluida', false) != true
          && data.get('questFalha', false) != true
          && data.get('pagamentoFeito', false) != true
          && data.get('ptStartedAt', 0) == 0;
      }
      // Adição de personagem por usuário EXTERNO (amigo do líder/convidado ou
      // visitante de PT pública), somente PRÉ-Quest. Só pode ADICIONAR:
      //   • nunca remover (selectedIds só cresce — superconjunto estrito);
      //   • nunca iniciar/concluir/falhar/pagar/arquivar/trancar/pausar;
      //   • nunca transferir liderança, mudar visibilidade, nº de slots,
      //     horário, servidor, tipo de PT, convidados ou remover membros.
      // (Os invariantes de estrutura valem para QUALQUER usuário externo —
      // o cliente grava o documento inteiro, então é aqui que a operação
      // "somente adicionar" é realmente garantida.)
      function isExternalAddOnlyChange(data, incoming) {
        return data.visibility == 'public'
          && data.get('ptStartedAt', 0) == 0
          && data.get('questConcluida', false) != true
          && data.get('questFalha', false) != true
          && data.get('pagamentoFeito', false) != true
          && incoming.get('ptStartedAt', 0) == 0
          && incoming.get('questConcluida', false) != true
          && incoming.get('questFalha', false) != true
          && incoming.get('pagamentoFeito', false) != true
          && incoming.get('archived', false) == false
          && incoming.get('isLocked', false) == false
          && incoming.get('isPaused', false) == false
          && incoming.leaderUid == data.leaderUid
          && incoming.visibility == data.visibility
          && incoming.slots == data.slots
          && incoming.get('horarioTimestamp', null) == data.get('horarioTimestamp', null)
          && incoming.get('ptType', null) == data.get('ptType', null)
          && incoming.get('servidor', null) == data.get('servidor', null)
          && incoming.selectedIds.hasAll(data.selectedIds)
          && incoming.selectedIds.size() > data.selectedIds.size()
          && incoming.get('members', []).hasAll(data.get('members', []))
          && incoming.get('invitedUsers', []).hasAll(data.get('invitedUsers', []));
      }
      allow read: if isAuth() && isApproved() && (
        isBoss() || isPartyParticipant(resource.data) || isPublicActiveParty(resource.data)
      );
      allow create: if isAuth()
        && isApproved()
        && isCreatingAsOwner('leaderUid');
      // Depois da Quest, liquidação financeira e pedidos de finalização são
      // exclusivos de Líder/Boss; participantes continuam editando somente PT
      // ainda ativa e não podem concluir/falhar sozinhos. Antes do início,
      // PARTICIPANTES (roster/`members`/convidados) editam a composição —
      // inclusive JOGADOR: a coluna entra no roster `members` no momento em
      // que o usuário é selecionado (PartyPanel grava playerUid + members no
      // mesmo update). Externos: apenas a adição da regra acima.
      allow update: if isApproved() && (
        isBoss()
        || isPartyLeader(resource.data)
        || (
          isPartyParticipant(resource.data)
          && resource.data.get('questConcluida', false) != true
          && request.resource.data.get('questConcluida', false) != true
          && request.resource.data.get('questFalha', false) != true
        )
        || (isAuth() && isExternalAddOnlyChange(resource.data, request.resource.data))
      );
      allow delete: if isApproved() && (isPartyLeader(resource.data) || isBoss());
    }
    // Legado: novas PTs finalizadas passam a partyArchives via Admin SDK.
    // A leitura de arquivos antigos fica limitada a participantes conhecidos.
    match /archivedParties/{partyId} {
      function isArchivedParticipant(data) {
        return data.leaderUid == request.auth.uid
          || (data.participantUids != null && request.auth.uid in data.participantUids)
          || (data.members != null && request.auth.uid in data.members);
      }
      allow read: if isAuth() && isApproved() && (isBoss() || isArchivedParticipant(resource.data));
      allow create, update: if false;
      allow delete: if isAuth() && isApproved() && isBoss();
    }
    // Arquivo canônico sanitizado criado exclusivamente pela Function.
    match /partyArchives/{partyId} {
      allow read: if isAuth() && isApproved() && (
        isBoss() || (resource.data.participantUids != null && request.auth.uid in resource.data.participantUids)
      );
      allow write: if false;
    }
    // Settlement é compartilhado somente entre Líder/Boss e beneficiários da divisão.
    match /partySettlements/{partyId} {
      allow read: if isAuth() && isApproved() && (
        isBoss()
        || resource.data.leaderUid == request.auth.uid
        || (resource.data.viewerUids != null && request.auth.uid in resource.data.viewerUids)
      );
      allow write: if false;
    }
    // Comando durável de finalização. A Function valida novamente líder/Boss,
    // revisão e pagamentos antes de modificar qualquer histórico.
    match /partyFinalizationRequests/{requestId} {
      // Acompanhamento em tempo real do PRÓPRIO pedido: após criar, o painel
      // escuta este documento (onSnapshot) para refletir `state` "completed"
      // ou "failed" + `lastError` legível ao usuário. Sem esta leitura, a
      // solicitação continua processando normalmente no backend, mas o
      // cliente nunca vê o resultado em tempo real (cai sempre no aviso
      // "Acompanhamento indisponível"). Somente quem criou o pedido (Líder/
      // Boss, garantido pelo `create` abaixo) lê o próprio documento; Boss
      // pode ler qualquer um para suporte.
      allow read: if isAuth() && isApproved() && (
        resource.data.requestedByUid == request.auth.uid || isBoss()
      );
      allow create: if isAuth()
        && isApproved()
        && request.resource.data.keys().hasOnly([
          'id', 'partyId', 'reason', 'requestedByUid', 'expectedRevision',
          'state', 'clientRequestedAt', 'requestedAt'
        ])
        && request.resource.data.id == requestId
        && request.resource.data.partyId is string
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.reason in ['payment', 'quest_failed']
        && request.resource.data.state == 'requested'
        && request.resource.data.expectedRevision is number
        && request.resource.data.clientRequestedAt is number
        && exists(/databases/$(database)/documents/parties/$(request.resource.data.partyId))
        && (
          get(/databases/$(database)/documents/parties/$(request.resource.data.partyId)).data.leaderUid == request.auth.uid
          || isBoss()
        );
      allow update, delete: if false;
    }
    match /partyFinalizationJobs/{partyId} {
      allow read, write: if false;
    }
    match /waitingList/{serviceId} {
      allow read: if isAuth() && isApproved();
      allow create: if (
          isAuth()
          && isApproved()
          && isCreatingAsOwner('createdBy')
        )
        || (
          isAuth()
          && request.resource.data.source == 'public_form'
          && request.resource.data.addedBy == 'Qualquer um'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.valorCombinado == 0
          && request.resource.data.personagem is string
          && request.resource.data.personagem.size() > 0
          && request.resource.data.personagem.size() <= 50
          && request.resource.data.ownerName is string
          && request.resource.data.ownerName.size() <= 50
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 300
        );
      allow update: if isAuth() && isApproved() && (
        !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy']))
        || isOwner('createdBy')
        || isVIP()
      );
      allow delete: if isVIP() && isApproved();
    }
    match /feedback/{feedbackId} {
      allow read: if isAuth() && isApproved();
      allow create: if isAuth() && isApproved() && isCreatingAsOwner('createdBy');
      allow update: if isVIP() && isApproved();
      allow delete: if isBoss();
    }
    match /notifications/{notifId} {
      allow read: if isAuth() && isApproved();
      allow create: if isAuth()
        || (
          request.resource.data.type == 'request_entry'
          && request.resource.data.targetRole == 'Boss'
          && request.resource.data.status == 'unread'
          && request.resource.data.userId is string
          && request.resource.data.userName is string
          && request.resource.data.userEmail is string
          && request.resource.data.createdAt is number
        );
      allow update: if isAuth();
      allow delete: if isAuth() && isApproved() && (
        isBoss()
        || resource.data.userId == request.auth.uid
      );
    }
    // ── Push (Web Push/FCM): tokens de dispositivos por usuário ────────────
    // O usuário só lê/escreve os PRÓPRIOS tokens — nunca os de outro. O envio
    // é feito pelas Cloud Functions (Admin SDK, que não passa por rules).
    match /pushTokens/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    // ── Preferências de notificação espelhadas no Firestore ────────────────
    // O frontend sincroniza aqui o que o BACKEND precisa conhecer (antecedência
    // do Bazaar, janelas 30/15/5 das PTs, fuso). Só o dono lê/escreve.
    match /userNotificationPrefs/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }
    // ── Marcadores anti-reenvio das Cloud Functions (idempotência) ─────────
    // Coleção interna do backend — os watchers gravam aqui "este evento já foi
    // notificado para este usuário". Nenhum cliente tem acesso (Admin SDK
    // ignora rules).
    match /notifyState/{stateId} {
      allow read, write: if false;
    }
    match /donations/{donationId} {
      allow read: if isAuth() && isApproved();
      allow create: if isAuth() && isApproved() && isCreatingAsOwner('userId');
      allow update: if isBoss();
      allow delete: if isBoss();
    }
    match /vipCreditRequests/{requestId} {
      allow read: if isAuth() && isApproved() && (
        resource.data.userId == request.auth.uid
        || isBoss()
      );
      allow create: if isAuth()
        && isApproved()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.requestedDays is int
        && request.resource.data.requestedDays >= 30
        && request.resource.data.requestedDays % 30 == 0
        && request.resource.data.status == 'pendente';
      allow update, delete: if isBoss();
    }
    match /presence/count {
      allow read: if isAuth() && isApproved();
      allow create, update: if isAuth() && isApproved();
    }
    match /presence/{userId} {
      allow read: if isAuth() && isApproved();
      allow create: if isAuth() && isApproved() && request.auth.uid == userId;
      allow update: if isAuth() && isApproved() && request.auth.uid == userId;
      allow delete: if isAuth() && isApproved() && request.auth.uid == userId;
    }
    match /user_logs/{userId} {
      allow create, update: if isAuth() && isApproved() && request.auth.uid == userId;
      allow read: if isBoss();
      allow delete: if isBoss();
    }
    match /userCharacters/{userId} {
      allow read, write: if isAuth() && isApproved() && request.auth.uid == userId;
    }
    function isActiveVip() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vipExpiresAt != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vipExpiresAt > request.time;
    }
    function isServiceiro() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.serviceiro == true;
    }
    match /sharedServices/{userId} {
      allow read: if isAuth() && isApproved() && (
        request.auth.uid == userId
        || isBoss()
        || (
          exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid)).data.status == 'aceita'
        )
      );
      allow create, update: if isAuth()
        && isApproved()
        && request.auth.uid == userId
        && (isBoss() || (isActiveVip() && isServiceiro()))
        && request.resource.data.keys().hasOnly([
          'serviceiroUid',
          'services',
          'updatedAt',
          'updatedAtMs'
        ])
        && request.resource.data.serviceiroUid == request.auth.uid
        && request.resource.data.services is list
        && request.resource.data.services.size() <= 500
        && request.resource.data.updatedAtMs is number;
      allow delete: if isBoss();
    }
    match /userStats/{userId} {
      allow read: if isAuth() && isApproved();
      allow create: if isAuth() && isApproved() && request.auth.uid == userId;
      allow update: if isAuth() && isApproved() && (
        request.auth.uid == userId || isBoss()
      );
      allow delete: if isAuth() && isApproved() && (
        request.auth.uid == userId || isBoss()
      );
      match /processedParties/{partyId} {
        allow read, write: if isAuth() && isApproved() && request.auth.uid == userId;
      }
    }
    match /bazaar/{docId} {
      allow read: if isAuth() && isApproved();
      allow create, update, delete: if isBoss()
        && docId in ['metadata', 'current'];
    }
    match /serviceRequests/{requestId} {
      allow read: if isAuth() && isApproved() && (
        resource.data.serviceiroUid == request.auth.uid || isBoss()
      );
      allow create: if isAuth()
        && exists(/databases/$(database)/documents/users/$(request.resource.data.serviceiroUid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.serviceiroUid)).data.status == 'aprovado'
        && (
          get(/databases/$(database)/documents/users/$(request.resource.data.serviceiroUid)).data.role == 'Boss'
          || get(/databases/$(database)/documents/users/$(request.resource.data.serviceiroUid)).data.serviceiro == true
        )
        && request.resource.data.keys().hasOnly([
          'id', 'personagem', 'ownerName', 'servidor', 'voc', 'level',
          'notes', 'whatsappCountry', 'whatsappArea', 'whatsappNumber',
          'quest', 'paymentMethod', 'serviceiroUid', 'status',
          'createdAt', 'source'
        ])
        && request.resource.data.source == 'public_form'
        && request.resource.data.status == 'pendente'
        && request.resource.data.personagem is string
        && request.resource.data.personagem.size() > 0
        && request.resource.data.personagem.size() <= 50
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 50
        && request.resource.data.servidor is string
        && request.resource.data.servidor.size() > 0
        && request.resource.data.servidor.size() <= 40
        && request.resource.data.level is number
        && request.resource.data.level >= 0
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 300
        && request.resource.data.quest in ['soulwar', 'sanguine']
        && request.resource.data.createdAt is number;
      allow update: if false;
      allow delete: if isAuth() && isApproved() && (
        resource.data.serviceiroUid == request.auth.uid || isBoss()
      );
    }
    match /rankingHistory/{monthKey} {
      allow read: if isAuth() && isApproved();
      allow create: if isBoss()
        && request.resource.data.monthKey == monthKey
        && request.resource.data.entries is list
        && request.resource.data.totalPlayers is number
        && request.resource.data.generatedAtMs is number;
      allow update, delete: if false;
    }
    // Quadro "Mês Atual" consolidado — cache derivado de userStats/dailyStats,
    // escrito APENAS pelo backend (transação de stats + Cloud Function
    // agendada de reset/reconciliação, via Admin SDK). O cliente só lê.
    match /rankingMonthly/{monthKey} {
      allow read: if isAuth() && isApproved();
      allow write: if false;
      match /users/{uid} {
        allow read: if isAuth() && isApproved();
        allow write: if false;
      }
    }
    match /bazaarInterests/current {
      allow read: if isAuth() && isApproved();
      allow create, update, delete: if isBoss();
      allow create: if isAuth()
        && isApproved()
        && request.resource.data.keys().hasOnly([
          'bazaarVersion',
          'updatedAtMs',
          'byAuction',
          'updatedAt'
        ])
        && request.resource.data.bazaarVersion is string
        && request.resource.data.bazaarVersion.size() > 0
        && request.resource.data.bazaarVersion.size() <= 80
        && request.resource.data.updatedAtMs is number
        && request.resource.data.byAuction is map;
      allow update: if isAuth()
        && isApproved()
        && request.resource.data.keys().hasOnly([
          'bazaarVersion',
          'updatedAtMs',
          'byAuction',
          'updatedAt'
        ])
        && request.resource.data.bazaarVersion == resource.data.bazaarVersion
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'byAuction',
          'updatedAtMs',
          'updatedAt'
        ])
        && request.resource.data.updatedAtMs is number
        && request.resource.data.byAuction is map;
      allow delete: if isBoss();
    }
    match /bazaarInterests/{auctionId} {
      allow read: if isAuth() && isApproved();
      allow create, update: if false;
      allow delete: if isBoss();
      match /interestedUsers/{uid} {
        allow read: if isAuth() && isApproved();
        allow create, update: if false;
        allow delete: if isAuth()
          && isApproved()
          && (request.auth.uid == uid || isBoss());
      }
    }
    match /{path=**}/interestedUsers/{uid} {
      allow read: if isAuth() && isApproved();
    }
    // ========================================================================
    // AQUISIÇÃO TEMPORÁRIA DE PERSONAGEM — characterAcquisitions/{id}
    //
    // Registro imutável da propriedade original e dos direitos financeiros do
    // adquirente. DONO, ADQUIRENTE, custo e taxas não podem ser alterados após
    // a criação; somente o ciclo de vida e os valores posteriores da Quest/venda
    // podem mudar pelos participantes autorizados.
    // ========================================================================
    match /characterAcquisitions/{acquisitionId} {
      // Somente os dois usuários financeiros têm acesso ao documento
      // compartilhado. Dados privados de Quest vivem na coleção abaixo.
      function isNegotiationParticipant() {
        return request.auth.uid == resource.data.originalOwnerUid
          || request.auth.uid == resource.data.acquirerUid
          || isBoss();
      }
      function isOriginalOwnerOrBoss() {
        return request.auth.uid == resource.data.originalOwnerUid || isBoss();
      }
      function isBuyerPaymentTransition() {
        return resource.data.status == 'pre_approved'
          && request.resource.data.status == 'payment_confirmed';
      }
      function validStatusTransition() {
        return request.resource.data.status == resource.data.status
          || (resource.data.status == 'pre_approved' && request.resource.data.status == 'payment_confirmed')
          // Compatibilidade de negociações criadas pelo fluxo anterior.
          || (resource.data.status == 'created' && request.resource.data.status == 'quest_completed')
          || (resource.data.status == 'payment_confirmed' && request.resource.data.status == 'quest_completed')
          || (resource.data.status == 'quest_completed' && request.resource.data.status in ['for_sale', 'sold'])
          || (resource.data.status == 'for_sale' && request.resource.data.status in ['quest_completed', 'sold']);
      }
      // GET em documento INEXISTENTE é permitido (`resource == null`): a
      // transação de pré-aprovação lê o ID determinístico (dono+personagem)
      // para detectar duplicata ANTES do create. Sem isto, o `||` das rules
      // errava em `resource.data` e NEGAVA a leitura para todo não-Boss —
      // era exatamente o "Missing or insufficient permissions" do botão
      // "Pré-aprovar venda". Não há dado exposto (o documento não existe) e
      // o `create` abaixo continua restrito ao DONO original. Documentos
      // EXISTENTES seguem legíveis somente pelos participantes/Boss.
      allow get: if isAuth() && isApproved() && (
        resource == null || isNegotiationParticipant()
      );
      allow list: if isAuth() && isApproved() && isNegotiationParticipant();
      // Pré-aprovação: exclusivamente o DONO original define preço e taxa.
      allow create: if isAuth()
        && isApproved()
        && request.auth.uid == request.resource.data.originalOwnerUid
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'id', 'partyId', 'partyName', 'characterId', 'characterName',
          'server', 'vocation', 'level',
          'originalOwnerUid', 'originalOwnerName', 'sellerMainCharacterName',
          'acquirerUid', 'acquirerName', 'buyerMainCharacterName',
          'financialRightsHolderUid', 'financialRightsHolderName',
          'originalCharacterCost', 'personalFee', 'bazaarFee', 'finalPaid', 'sellerReceived',
          'status', 'createdAt', 'createdByUid', 'createdByName', 'preApprovedAt',
          'salePayoutStatus', 'updatedAt'
        ])
        && request.resource.data.id == acquisitionId
        && request.resource.data.partyId is string
        && request.resource.data.characterId is string
        && request.resource.data.characterName is string
        && request.resource.data.server is string
        && request.resource.data.vocation is string
        && request.resource.data.level is number
        && request.resource.data.originalOwnerUid is string
        && request.resource.data.originalOwnerName is string
        && request.resource.data.sellerMainCharacterName is string
        && request.resource.data.sellerMainCharacterName.size() > 0
        && request.resource.data.acquirerUid is string
        && request.resource.data.acquirerName is string
        && request.resource.data.buyerMainCharacterName is string
        && request.resource.data.buyerMainCharacterName.size() > 0
        && request.resource.data.originalOwnerUid != request.resource.data.acquirerUid
        && request.resource.data.financialRightsHolderUid == request.resource.data.acquirerUid
        && request.resource.data.financialRightsHolderName == request.resource.data.acquirerName
        && request.resource.data.originalCharacterCost is number
        && request.resource.data.originalCharacterCost >= 0
        && request.resource.data.personalFee in [0, 25, 50]
        && request.resource.data.bazaarFee == 50
        // O comprador paga ao vendedor o valor integral, incluindo Bazaar.
        && request.resource.data.sellerReceived == request.resource.data.originalCharacterCost + request.resource.data.personalFee + request.resource.data.bazaarFee
        && request.resource.data.finalPaid == request.resource.data.sellerReceived
        && request.resource.data.status == 'pre_approved'
        && request.resource.data.salePayoutStatus == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.preApprovedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isAuth()
        && isApproved()
        && isNegotiationParticipant()
        // Valores de origem, dono, adquirente e taxas nunca mudam depois da pré-aprovação.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'questType', 'questCompletedAt', 'listedAt', 'soldAt', 'saleValue',
          'paymentConfirmedAt', 'paymentConfirmedByUid',
          'salePayoutStatus', 'salePayoutConfirmedAt', 'salePayoutConfirmedByUid',
          'updatedAt'
        ])
        && validStatusTransition()
        // PAGAMENTO 1: só o comprador pode registrar data/hora da confirmação.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentConfirmedAt', 'paymentConfirmedByUid']) || (
          resource.data.status == 'pre_approved'
          && request.resource.data.status == 'payment_confirmed'
          && request.auth.uid == resource.data.acquirerUid
          && request.resource.data.paymentConfirmedByUid == request.auth.uid
          && request.resource.data.paymentConfirmedAt is timestamp
        ))
        // Listagem no Bazaar é controlada exclusivamente pelo dono original.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['listedAt']) || (
          isOriginalOwnerOrBoss()
          && request.resource.data.status == 'for_sale'
          && request.resource.data.listedAt is timestamp
        ))
        // `saleValue` é apenas a publicação do Character.valorVenda oficial.
        // Só o dono pode publicar/ajustar esse espelho antes do repasse.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['saleValue', 'soldAt']) || (
          isOriginalOwnerOrBoss()
          && request.resource.data.status == 'sold'
          && request.resource.data.saleValue is number
          && request.resource.data.saleValue >= 0
          && request.resource.data.soldAt is timestamp
          && (!resource.data.keys().hasAll(['salePayoutStatus']) || resource.data.salePayoutStatus != 'confirmed')
        ))
        // Entrar/sair de estados de venda também é responsabilidade do dono.
        && (!(
          request.resource.data.status != resource.data.status
          && (resource.data.status in ['for_sale', 'sold'] || request.resource.data.status in ['for_sale', 'sold'])
        ) || isOriginalOwnerOrBoss())
        // PAGAMENTO 2: só o dono confirma uma única vez o repasse pendente.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['salePayoutStatus', 'salePayoutConfirmedAt', 'salePayoutConfirmedByUid']) || (
          isOriginalOwnerOrBoss()
          && request.resource.data.status == 'sold'
          && (
            (
              !resource.data.keys().hasAll(['salePayoutStatus'])
              && request.resource.data.salePayoutStatus == 'pending'
            )
            || (
              resource.data.salePayoutStatus == 'pending'
              && request.resource.data.salePayoutStatus == 'confirmed'
              && request.resource.data.salePayoutConfirmedAt is timestamp
              && request.resource.data.salePayoutConfirmedByUid == request.auth.uid
            )
          )
        ))
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAll(['questType']) || request.resource.data.questType in ['soulwar', 'sanguine'])
        && (!request.resource.data.keys().hasAll(['saleValue']) || (request.resource.data.saleValue is number && request.resource.data.saleValue >= 0))
        && (!request.resource.data.keys().hasAll(['questCompletedAt']) || (request.resource.data.questCompletedAt is timestamp || request.resource.data.questCompletedAt is number))
        && (!request.resource.data.keys().hasAll(['listedAt']) || (request.resource.data.listedAt is timestamp || request.resource.data.listedAt is number))
        && (!request.resource.data.keys().hasAll(['soldAt']) || (request.resource.data.soldAt is timestamp || request.resource.data.soldAt is number))
        && (!request.resource.data.keys().hasAll(['salePayoutStatus']) || request.resource.data.salePayoutStatus in ['pending', 'confirmed'])
        && (!request.resource.data.keys().hasAll(['salePayoutConfirmedAt']) || (request.resource.data.salePayoutConfirmedAt is timestamp || request.resource.data.salePayoutConfirmedAt is number));
      allow delete: if false;
    }
    // Dados exclusivamente financeiros da Quest (drop/lucro) pertencem ao
    // ADQUIRENTE. O DONO original não pode ler nem atualizar esta coleção.
    match /characterAcquisitionBuyerDetails/{acquisitionId} {
      allow read: if isAuth() && isApproved() && (
        resource.data.acquirerUid == request.auth.uid || isBoss()
      );
      allow create: if isAuth()
        && isApproved()
        && request.resource.data.acquirerUid == request.auth.uid
        && exists(/databases/$(database)/documents/characterAcquisitions/$(acquisitionId))
        && get(/databases/$(database)/documents/characterAcquisitions/$(acquisitionId)).data.acquirerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'id', 'acquisitionId', 'acquirerUid', 'questType', 'questDrops', 'questDropsSource',
          'questProfit', 'questProfitSource', 'questCompletedAt', 'updatedAt'
        ])
        && request.resource.data.id == acquisitionId
        && request.resource.data.acquisitionId == acquisitionId
        && request.resource.data.questType in ['soulwar', 'sanguine']
        && request.resource.data.questDrops is list
        && request.resource.data.questDrops.size() <= 20
        && request.resource.data.questDropsSource in ['pt', 'buyer']
        && request.resource.data.questProfit is number
        && request.resource.data.questProfitSource in ['pt', 'buyer']
        && request.resource.data.questProfit >= 0
        && request.resource.data.questCompletedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isAuth()
        && isApproved()
        && (resource.data.acquirerUid == request.auth.uid || isBoss())
        && exists(/databases/$(database)/documents/characterAcquisitions/$(acquisitionId))
        && get(/databases/$(database)/documents/characterAcquisitions/$(acquisitionId)).data.acquirerUid == resource.data.acquirerUid
        && request.resource.data.acquirerUid == resource.data.acquirerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'questType', 'questDrops', 'questDropsSource', 'questProfit', 'questProfitSource', 'questCompletedAt', 'updatedAt'
        ])
        && request.resource.data.questType in ['soulwar', 'sanguine']
        && request.resource.data.questDrops is list
        && request.resource.data.questDrops.size() <= 20
        && request.resource.data.questDropsSource in ['pt', 'buyer']
        && request.resource.data.questProfit is number
        && request.resource.data.questProfitSource in ['pt', 'buyer']
        && request.resource.data.questProfit >= 0
        && (request.resource.data.questCompletedAt is timestamp || request.resource.data.questCompletedAt is number)
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
