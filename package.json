{
  "name": "chernobyl-pt",
  "productName": "Chernobyl PT",
  "description": "Aplicativo para gerenciamento de personagens, PTs, services, Bazaar e estatísticas no Tibia.",
  "author": "Exori Coins",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite --host",
    "electron": "vite build && electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "build:electron": "vite build && electron-builder --win",
    "publish": "vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "electron-updater": "^6.8.9",
    "firebase": "^12.16.0",
    "lucide-react": "^1.14.0",
    "playwright": "^1.61.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.3",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.chernobyl.pt",
    "productName": "Chernobyl PT",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "*.cjs",
      "build/icon.ico",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chernobyl PT"
    },
    "publish": {
      "provider": "github",
      "owner": "Luiz415",
      "repo": "Chernobyl-PT",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "electron-winstaller@5.4.0": true,
    "protobufjs@7.6.5": true
  }
}